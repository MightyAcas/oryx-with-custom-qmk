// Scissoring reduction

AK(GV, KC_G, KC_V, false, KC_R)   // GV produces GR   ... inroll
AK(GR, KC_G, KC_R, false, KC_V)   // GR produces GV


// SFB reduction

AK(LH, KC_L, KC_H, false, KC_Y)   // LH produces LY   ... alternation
AK(LY, KC_L, KC_Y, false, KC_H)   // LY produces LH

AK(NR, KC_N, KC_R, false, KC_Y)   // NR produces NY   ... alternationn
AK(NY, KC_N, KC_Y, false, KC_R)   // NY produces NR   ... "anyway" and "anywhere" suck now but besides that this is the best i can prob do

AK(NH, KC_N, KC_H, false, KC_QUOTE)   // NH produces N'   ... alternation
AK(NQ, KC_N, KC_QUOTE, false, KC_H)   // N' produces NH   ... creates "n't" outroll which is nice

AK(WC, KC_W, KC_C, false, KC_R)   // WC produces WR   ... inroll
AK(WR, KC_W, KC_R, false, KC_C)   // WR produces WC   ... prob the best of the slide turned into adaptive rules



